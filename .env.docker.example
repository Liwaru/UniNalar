# Copy to .env.docker and set unique local credentials before starting Docker.
APP_NAME=UniNalar
APP_KEY=
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12
LOG_CHANNEL=stderr
LOG_LEVEL=debug
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=uninlar
DB_USERNAME=uninlar
DB_PASSWORD=
MYSQL_DATABASE=uninlar
MYSQL_USER=uninlar
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
UNINLAR_DUMMY_STUDENTS=40
